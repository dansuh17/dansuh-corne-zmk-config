#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE_QWT 0
#define L_MOD    1
#define R_MOD    2
#define NAV      3
#define ADJ      4

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: QWERTY inner 3x5 core + rare utilities on outer pinky columns */
        base_qwt_layer {
            display-name = "QWERTY";
            bindings = <
                &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P      &kp LG(LS(N4))
                &kp ESC  &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &kp SEMI   &kp LG(LS(N5))
                &kp F18  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH   &caps_word
                              &mo NAV  &kp SPACE  &mo L_MOD      &mo R_MOD  &kp BSPC  &kp LSHFT
            >;
        };

        /* Layer 1: Left Half-Mods (Right Half = &trans Base QWERTY) */
        l_mod_layer {
            display-name = "L-Mod";
            bindings = <
                &trans  &trans    &trans    &trans     &trans    &trans        &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT &trans        &trans  &trans  &trans  &trans  &trans  &trans
                &mo ADJ &trans    &trans    &trans     &trans    &trans        &trans  &trans  &trans  &trans  &trans  &trans
                                  &trans    &trans     &trans                  &trans  &kp TAB &trans
            >;
        };

        /* Layer 2: Right Half-Mods (Left Half = &trans Base QWERTY) */
        r_mod_layer {
            display-name = "R-Mod";
            bindings = <
                &trans  &trans  &trans  &trans   &trans  &trans        &trans  &trans     &trans    &trans    &trans    &trans
                &trans  &trans  &trans  &trans   &trans  &trans        &trans  &kp RSHFT  &kp RCTRL &kp RALT  &kp RGUI  &trans
                &trans  &trans  &trans  &trans   &trans  &trans        &trans  &trans     &trans    &trans    &trans    &mo ADJ
                                &trans  &kp TAB  &trans                &trans  &trans     &trans 
            >;
        };

        /* Layer 3: NAV (Hold L_OUT) */
        nav_layer {
            display-name = "Nav";
            bindings = <
                &trans   &kp ESC     &caps_word  &kp LG(LS(N4))  &kp LG(LS(N5))  &kp LG(LS(A))       &kp ESC      &kp LG(LS(LBKT))  &kp LC(D)  &kp LC(U)  &LG(LS(RBKT))  &kp DEL
                &trans   &kp LGUI    &kp LALT    &kp LCTRL       &kp LSHFT       &kp TAB             &kp BSPC     &kp LEFT          &kp DOWNL  &kp UP     &kp RIGHT      &kp RET
                &mo ADJ  &kp LG(Z)   &kp LG(X)   &kp LG(C)       &kp LG(V)       &kp LG(LS(Z))       &kp INS      &kp HOME          &kp PG_DN  &kp PG_UP  &kp END        &trans
                                     &trans      &trans          &trans                              &trans       &kp RET           &kp DEL
            >;
        };

        /* Layer 4: Bluetooth & Bootloader */
        adj_layer {
            display-name = "Adjust";
            bindings = <
                &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &out OUT_TOG        &none        &none   &none   &none  &none       &trans
                &trans  &none         &none         &none         &none         &none               &none        &none   &none   &none  &none       &trans
                &trans  &none         &none         &none         &none         &bootloader         &bootloader  &none   &none   &none  &bt BT_CLR  &trans
                                      &trans        &trans        &trans                            &trans       &trans  &trans 
            >;
        };
    };
};

